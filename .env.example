# Ollama (로컬 LLM 서버)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.6:35b-a3b

# 수집 데이터 저장 위치(외장 스토리지 등). 비워 두거나 존재하지 않는 경로면
# 저장소 안의 ./data/news_data 로 폴백한다. 예: /Volumes/MyDisk/news_data
NEWS_STORAGE_PATH=

# 수동 수집 트리거(POST /api/collect/now) 비밀번호
# 이 값이 비어 있으면 엔드포인트는 항상 거부한다(fail-closed).
NEWS_COLLECT_PW=

# 웹 서버 (기본 0.0.0.0:3400)
HOST=0.0.0.0
PORT=3400
